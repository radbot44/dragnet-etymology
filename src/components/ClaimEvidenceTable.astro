---
import {
  CLAIM_ASSESSMENT_LABELS,
  EVIDENCE_RELATIONSHIP_LABELS,
  type EvidenceLink,
  type HydratedClaimRecord,
} from '../lib/claims';
import {
  RECORD_TYPE_LABELS,
  VERIFICATION_LABELS,
  type CitationRecord,
} from '../lib/ledgers';

interface Props {
  sectionId: string;
  title: string;
  subtitle?: string;
  edges: EvidenceLink[];
  currentCaseSlug: string;
  advancingCitationRef?: string | null;
  citationById: Map<string, CitationRecord>;
  claimById: Map<string, HydratedClaimRecord>;
  emptyMessage: string;
}

const {
  sectionId,
  title,
  subtitle,
  edges,
  currentCaseSlug,
  advancingCitationRef = null,
  citationById,
  claimById,
  emptyMessage,
} = Astro.props;
---

<section id={sectionId} style="margin: 1.85rem 0;">
  <h2 style="font-family: var(--font-serif); font-size: 1.42rem; margin: 0 0 0.3rem;">
    {title} ({edges.length})
  </h2>
  {subtitle && (
    <p style="font-size: 0.9rem; color: var(--ink-muted); margin: 0 0 0.85rem;">
      {subtitle}
    </p>
  )}

  {edges.length === 0 ? (
    <p class="citation-empty" style="font-size: 0.9rem; color: var(--ink-muted); margin: 0.5rem 0;">
      {emptyMessage}
    </p>
  ) : (
    <div class="citation-table-wrap" role="region" aria-label={title} tabindex="0">
      <table class="citation-table responsive-evidence-table" role="table">
        <thead role="rowgroup">
          <tr role="row">
            <th scope="col" role="columnheader">Reference</th>
            <th scope="col" role="columnheader">Primary Witness / Premise Claim</th>
            <th scope="col" role="columnheader">Role &amp; Directness</th>
            <th scope="col" role="columnheader">Evidentiary Reason &amp; Notes</th>
            <th scope="col" role="columnheader">Target Status</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {edges.map((edge) => {
            const isCitation = edge.ref.startsWith('CERT-');
            const cit = isCitation ? citationById.get(edge.ref) ?? null : null;
            const targetClaim = !isCitation ? claimById.get(edge.ref) ?? null : null;
            const href = isCitation
              ? `/citations/${cit ? cit.slug : edge.ref.toLowerCase()}/`
              : `/claims/${targetClaim ? targetClaim.slug : edge.ref.toLowerCase()}/`;
            const isCrossCase = isCitation
              ? Boolean(cit && cit.case_slug !== currentCaseSlug)
              : Boolean(targetClaim && targetClaim.case_slug !== currentCaseSlug);

            return (
              <tr role="row">
                <td role="cell" style="font-family: var(--font-mono); font-size: 0.8rem;">
                  <span class="mobile-label" aria-hidden="true">Reference</span>
                  <div>
                    <a href={href} style="font-weight: 700;">{edge.ref}</a>
                  </div>
                  {advancingCitationRef === edge.ref && (
                    <div style="margin-top: 0.25rem;">
                      <span class="badge badge-class-documentary">Advancing witness</span>
                    </div>
                  )}
                  {isCrossCase && (
                    <div style="font-size: 0.72rem; color: var(--ink-muted); margin-top: 0.2rem;">
                      Cross-case ({cit?.headword || targetClaim?.headword})
                    </div>
                  )}
                  {cit && (
                    <div style="font-family: var(--font-sans); font-size: 0.77rem; margin-top: 0.25rem;">
                      {cit.scan.hosted_path ? (
                        <a href={`/citations/${cit.slug}/#scan`}>View scan →</a>
                      ) : (
                        <a href={cit.source_url} target="_blank" rel="noopener noreferrer">Archive ↗</a>
                      )}
                    </div>
                  )}
                </td>

                <td role="cell">
                  <span class="mobile-label" aria-hidden="true">Witness or premise</span>
                  {cit ? (
                    <>
                      <div>
                        <a href={href}><strong>“{cit.attested_form}”</strong></a>{' '}
                        <span style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-muted);">
                          ({cit.date_display})
                        </span>
                      </div>
                      <div class="citation-source-location">{cit.source_publication}</div>
                    </>
                  ) : targetClaim ? (
                    <>
                      <div>
                        <a href={href}><strong>{targetClaim.short_label}</strong></a>
                      </div>
                      <div class="citation-source-location">{targetClaim.statement}</div>
                    </>
                  ) : (
                    <span>{edge.ref}</span>
                  )}
                </td>

                <td role="cell">
                  <span class="mobile-label" aria-hidden="true">Role &amp; directness</span>
                  <div class="claim-badge-row">
                    <span class={`badge badge-rel-${edge.relationship}`}>
                      {EVIDENCE_RELATIONSHIP_LABELS[edge.relationship]}
                    </span>
                    <span class="badge badge-directness">{edge.directness}</span>
                  </div>
                </td>

                <td role="cell" style="font-size: 0.86rem;">
                  <span class="mobile-label" aria-hidden="true">Evidentiary reason</span>
                  <div>{edge.reason}</div>
                  {edge.witness_note && (
                    <div class="witness-note">
                      <strong>Witness note:</strong> {edge.witness_note}
                    </div>
                  )}
                </td>

                <td role="cell">
                  <span class="mobile-label" aria-hidden="true">Target status</span>
                  {cit ? (
                    <div class="claim-badge-row">
                      <span class={`badge badge-type-${cit.record_type}`}>
                        {RECORD_TYPE_LABELS[cit.record_type]}
                      </span>
                      <span class={`badge badge-ver-${cit.verification_level}`}>
                        {VERIFICATION_LABELS[cit.verification_level]}
                      </span>
                    </div>
                  ) : targetClaim ? (
                    <div class="claim-badge-row">
                      <span class={`badge badge-class-${targetClaim.epistemic_kind}`}>
                        {targetClaim.epistemic_kind === 'documentary' ? 'Documentary' : 'Interpretive'}
                      </span>
                      <span class={`badge badge-assess-${targetClaim.assessment}`}>
                        {CLAIM_ASSESSMENT_LABELS[targetClaim.assessment]}
                      </span>
                    </div>
                  ) : (
                    <span class="badge">Unresolved</span>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
</section>
