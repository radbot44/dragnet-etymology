---
interface ReuseKitObj {
  wikipediaPrimaryRef: string;
  wikipediaGuidance: string;
  wiktionaryQuote: string;
  adsLDispatch: string;
  oedSlipSummary: string;
}

interface Props {
  slug: string;
  title?: string;
  author?: string;
  pubYear?: number;
  canonicalUrl?: string;
  ledgerPath: string;
  journalDoi?: string;
  bibtex: string;
  reuseKit?: ReuseKitObj;
  wikipediaPrimaryRef?: string;
  wikipediaGuidance?: string;
  wiktionaryQuote?: string;
  adsLDispatch?: string;
  oedSlipSummary?: string;
}

const props = Astro.props;
const slug = props.slug;
const ledgerPath = props.ledgerPath;
const journalDoi = props.journalDoi;
const bibtex = props.bibtex;
const wikipediaPrimaryRef = props.wikipediaPrimaryRef ?? props.reuseKit?.wikipediaPrimaryRef ?? '';
const wikipediaGuidance = props.wikipediaGuidance ?? props.reuseKit?.wikipediaGuidance ?? '';
const wiktionaryQuote = props.wiktionaryQuote ?? props.reuseKit?.wiktionaryQuote ?? '';
const adsLDispatch = props.adsLDispatch ?? props.reuseKit?.adsLDispatch ?? '';
const oedSlipSummary = props.oedSlipSummary ?? props.reuseKit?.oedSlipSummary ?? '';
---

<section class="reuse-drawer" aria-labelledby="reuse-kit-heading">
  <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.75rem;">
    <div>
      <div style="font-family: var(--font-mono); font-size: 0.74rem; text-transform: uppercase; color: var(--accent); font-weight: 700;">
        Open Researcher & Lexicographer Toolkit
      </div>
      <h2 id="reuse-kit-heading" style="font-family: var(--font-serif); font-size: 1.4rem; margin: 0.15rem 0 0;">
        Cite, Verify, or Reuse This Case File
      </h2>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; font-size: 0.84rem; font-weight: 600;">
      <a href={`/cases/${slug}.bib`} download={`${slug}.bib`}>Download .bib</a>
      <span>·</span>
      <a href={ledgerPath} target="_blank" rel="noopener noreferrer">Raw JSON Ledger</a>
      {journalDoi && (
        <>
          <span>·</span>
          <a href={`https://doi.org/${journalDoi}`} target="_blank" rel="noopener noreferrer">
            DOI: {journalDoi}
          </a>
        </>
      )}
    </div>
  </div>

  <div class="reuse-tabs" role="tablist" aria-label="Citation formats">
    <button type="button" class="reuse-tab" role="tab" aria-selected="true" id="tab-wiki" aria-controls="panel-wiki" tabindex="0" data-tab-target="panel-wiki">
      Wikipedia
    </button>
    <button type="button" class="reuse-tab" role="tab" aria-selected="false" id="tab-wikt" aria-controls="panel-wikt" tabindex="-1" data-tab-target="panel-wikt">
      Wiktionary
    </button>
    <button type="button" class="reuse-tab" role="tab" aria-selected="false" id="tab-adsl" aria-controls="panel-adsl" tabindex="-1" data-tab-target="panel-adsl">
      ADS-L
    </button>
    <button type="button" class="reuse-tab" role="tab" aria-selected="false" id="tab-oed" aria-controls="panel-oed" tabindex="-1" data-tab-target="panel-oed">
      OED
    </button>
    <button type="button" class="reuse-tab" role="tab" aria-selected="false" id="tab-bib" aria-controls="panel-bib" tabindex="-1" data-tab-target="panel-bib">
      BibTeX
    </button>
  </div>

  <div id="panel-wiki" aria-labelledby="tab-wiki" tabindex="0" class="reuse-panel active" role="tabpanel">
    <p style="font-size: 0.88rem; color: var(--ink-muted); margin: 0.35rem 0;">
      <strong>Policy note:</strong> {wikipediaGuidance}
    </p>
    <pre class="code-box" id="code-wiki">{wikipediaPrimaryRef}</pre>
    <button type="button" class="copy-btn" data-copy-from="code-wiki">Copy Wikipedia Primary Ref</button>
  </div>

  <div id="panel-wikt" aria-labelledby="tab-wikt" tabindex="0" hidden class="reuse-panel" role="tabpanel">
    <p style="font-size: 0.88rem; color: var(--ink-muted); margin: 0.35rem 0;">
      Formatted for direct insertion on Wiktionary entry or Citations pages under <code>WT:CFI</code> (durably archived print media):
    </p>
    <pre class="code-box" id="code-wikt">{wiktionaryQuote}</pre>
    <button type="button" class="copy-btn" data-copy-from="code-wikt">Copy Wiktionary Citation</button>
  </div>

  <div id="panel-adsl" aria-labelledby="tab-adsl" tabindex="0" hidden class="reuse-panel" role="tabpanel">
    <p style="font-size: 0.88rem; color: var(--ink-muted); margin: 0.35rem 0;">
      Ready-to-post plain-text note for the American Dialect Society mailing list (<code>ADS-L@LISTSERV.UGA.EDU</code>):
    </p>
    <pre class="code-box" id="code-adsl">{adsLDispatch}</pre>
    <button type="button" class="copy-btn" data-copy-from="code-adsl">Copy ADS-L Dispatch</button>
  </div>

  <div id="panel-oed" aria-labelledby="tab-oed" tabindex="0" hidden class="reuse-panel" role="tabpanel">
    <p style="font-size: 0.88rem; color: var(--ink-muted); margin: 0.35rem 0;">
      Formatted for the Oxford English Dictionary Antedatings & Other Evidence submission portal:
    </p>
    <pre class="code-box" id="code-oed">{oedSlipSummary}</pre>
    <button type="button" class="copy-btn" data-copy-from="code-oed">Copy OED Slip</button>
  </div>

  <div id="panel-bib" aria-labelledby="tab-bib" tabindex="0" hidden class="reuse-panel" role="tabpanel">
    <p style="font-size: 0.88rem; color: var(--ink-muted); margin: 0.35rem 0;">
      Standard BibTeX record (Zotero browser connector also detects this page's Highwire Press <code>citation_*</code> meta tags automatically):
    </p>
    <pre class="code-box" id="code-bib">{bibtex}</pre>
    <button type="button" class="copy-btn" data-copy-from="code-bib">Copy BibTeX</button>
  </div>
  <p class="evidence-notice" data-copy-status role="status"></p>
</section>

<script>
  document.querySelectorAll('.reuse-drawer').forEach((drawer) => {
    const tabs = Array.from(drawer.querySelectorAll<HTMLButtonElement>('.reuse-tab'));
    const panels = drawer.querySelectorAll<HTMLElement>('.reuse-panel');
    const status = drawer.querySelector('[data-copy-status]');
    function select(tab: HTMLButtonElement) {
      tabs.forEach((t) => {
        t.setAttribute('aria-selected', String(t === tab));
        t.tabIndex = t === tab ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.id !== tab.getAttribute('aria-controls');
        panel.classList.toggle('active', !panel.hidden);
      });
      if (status) status.textContent = '';
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        let next: number;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        select(tabs[next]);
        tabs[next].focus();
      });
    });

    drawer.querySelectorAll('[data-copy-from]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-copy-from');
        const el = id ? document.getElementById(id) : null;
        if (!el || !status) return;
        try {
          await navigator.clipboard.writeText(el.textContent || '');
          status.textContent = 'Copied to clipboard.';
        } catch {
          status.textContent = 'Couldn’t access the clipboard. Select and copy the text above.';
        }
      });
    });
  });
</script>
