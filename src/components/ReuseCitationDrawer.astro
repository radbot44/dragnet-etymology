---
interface Props {
  slug: string;
  title: string;
  author: string;
  pubYear: number;
  canonicalUrl: string;
  ledgerPath: string;
  zenodoDoi?: string;
  bibtex: string;
  wikipediaPrimaryRef: string;
  wikipediaGuidance: string;
  wiktionaryQuote: string;
  adsLDispatch: string;
  oedSlipSummary: string;
}

const {
  slug,
  ledgerPath,
  zenodoDoi,
  bibtex,
  wikipediaPrimaryRef,
  wikipediaGuidance,
  wiktionaryQuote,
  adsLDispatch,
  oedSlipSummary,
} = Astro.props;
---

<section class="reuse-drawer" aria-labelledby="reuse-kit-heading">
  <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.75rem;">
    <div>
      <div style="font-family: var(--font-mono); font-size: 0.74rem; text-transform: uppercase; color: var(--accent); font-weight: 700;">
        Open Researcher & Lexicographer Toolkit
      </div>
      <h2 id="reuse-kit-heading" style="font-family: var(--font-serif); font-size: 1.4rem; margin: 0.15rem 0 0;">
        Cite, Verify, or Reuse This Case File
      </h2>
    </div>
    <div style="display: flex; gap: 0.75rem; font-size: 0.84rem; font-weight: 600;">
      <a href={`/cases/${slug}.bib`} download={`${slug}.bib`}>Download .bib</a>
      <span>·</span>
      <a href={ledgerPath} target="_blank" rel="noopener noreferrer">Raw JSON Ledger</a>
      {zenodoDoi && (
        <>
          <span>·</span>
          <a href={`https://doi.org/${zenodoDoi}`} target="_blank" rel="noopener noreferrer">
            DOI: {zenodoDoi}
          </a>
        </>
      )}
    </div>
  </div>

  <div class="reuse-tabs" role="tablist" aria-label="Citation formats">
    <button type="button" class="reuse-tab" role="tab" aria-selected="true" data-tab-target="panel-wiki">
      Wikipedia (WP:PRIMARY Safe Ref)
    </button>
    <button type="button" class="reuse-tab" role="tab" aria-selected="false" data-tab-target="panel-wikt">
      Wiktionary (WT:CFI Quote)
    </button>
    <button type="button" class="reuse-tab" role="tab" aria-selected="false" data-tab-target="panel-adsl">
      ADS-L Listserv Dispatch
    </button>
    <button type="button" class="reuse-tab" role="tab" aria-selected="false" data-tab-target="panel-oed">
      OED Submission Slip
    </button>
    <button type="button" class="reuse-tab" role="tab" aria-selected="false" data-tab-target="panel-bib">
      BibTeX / Scholar
    </button>
  </div>

  <div id="panel-wiki" class="reuse-panel active" role="tabpanel">
    <p style="font-size: 0.88rem; color: var(--ink-muted); margin: 0.35rem 0;">
      <strong>Policy note:</strong> {wikipediaGuidance}
    </p>
    <pre class="code-box" id="code-wiki">{wikipediaPrimaryRef}</pre>
    <button type="button" class="copy-btn" data-copy-from="code-wiki">Copy Wikipedia Primary Ref</button>
  </div>

  <div id="panel-wikt" class="reuse-panel" role="tabpanel">
    <p style="font-size: 0.88rem; color: var(--ink-muted); margin: 0.35rem 0;">
      Formatted for direct insertion on Wiktionary entry or Citations pages under <code>WT:CFI</code> (durably archived print media):
    </p>
    <pre class="code-box" id="code-wikt">{wiktionaryQuote}</pre>
    <button type="button" class="copy-btn" data-copy-from="code-wikt">Copy Wiktionary Citation</button>
  </div>

  <div id="panel-adsl" class="reuse-panel" role="tabpanel">
    <p style="font-size: 0.88rem; color: var(--ink-muted); margin: 0.35rem 0;">
      Ready-to-post plain-text note for the American Dialect Society mailing list (<code>ADS-L@LISTSERV.UGA.EDU</code>):
    </p>
    <pre class="code-box" id="code-adsl">{adsLDispatch}</pre>
    <button type="button" class="copy-btn" data-copy-from="code-adsl">Copy ADS-L Dispatch</button>
  </div>

  <div id="panel-oed" class="reuse-panel" role="tabpanel">
    <p style="font-size: 0.88rem; color: var(--ink-muted); margin: 0.35rem 0;">
      Formatted for the Oxford English Dictionary Antedatings & Other Evidence submission portal:
    </p>
    <pre class="code-box" id="code-oed">{oedSlipSummary}</pre>
    <button type="button" class="copy-btn" data-copy-from="code-oed">Copy OED Slip</button>
  </div>

  <div id="panel-bib" class="reuse-panel" role="tabpanel">
    <p style="font-size: 0.88rem; color: var(--ink-muted); margin: 0.35rem 0;">
      Standard BibTeX record (Zotero browser connector also detects this page's Highwire Press <code>citation_*</code> meta tags automatically):
    </p>
    <pre class="code-box" id="code-bib">{bibtex}</pre>
    <button type="button" class="copy-btn" data-copy-from="code-bib">Copy BibTeX</button>
  </div>
</section>

<script>
  document.querySelectorAll('.reuse-drawer').forEach((drawer) => {
    const tabs = drawer.querySelectorAll('.reuse-tab[role="tab"]');
    const panels = drawer.querySelectorAll('.reuse-panel');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-tab-target');
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        panels.forEach((p) => p.classList.toggle('active', p.id === targetId));
      });
    });

    drawer.querySelectorAll('[data-copy-from]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-copy-from');
        const el = id ? document.getElementById(id) : null;
        if (!el) return;
        const original = btn.textContent;
        await navigator.clipboard.writeText(el.textContent || '');
        btn.textContent = 'Copied ✓';
        setTimeout(() => {
          btn.textContent = original;
        }, 1600);
      });
    });
  });
</script>
