---
import { VERIFICATION_LABELS, type CitationRecord } from '../lib/ledgers';

interface Props {
  featuredScans: CitationRecord[];
  additionalScans: CitationRecord[];
  externalPost1930: CitationRecord[];
}

const { featuredScans, additionalScans, externalPost1930 } = Astro.props;
---

<section id="primary-scans" class="split-section" style="margin: 2.2rem 0;">
  <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.85rem;">
    <h2 style="font-family: var(--font-serif); font-size: 1.5rem; margin: 0;">
      Primary-Source Scans ({featuredScans.length + additionalScans.length} Public-Domain Scans Hosted)
    </h2>
    <span style="font-size: 0.84rem; color: var(--ink-muted);">Click any scan to inspect full image or open permanent citation record</span>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr)); gap: 1.15rem;">
    {featuredScans.map((c) => (
      <figure style="margin: 0; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; background: var(--surface); display: flex; flex-direction: column;">
        <a href={c.scan.hosted_path!} target="_blank" rel="noopener noreferrer" style="display: block; background: #111;">
          <img
            src={c.scan.hosted_path!}
            alt={`Primary-source scan ${c.id}: ${c.attested_form} (${c.date_display})`}
            style="width: 100%; height: 220px; object-fit: cover; object-position: top; display: block;"
            loading="lazy"
          />
        </a>
        <figcaption style="padding: 0.85rem 1rem; font-size: 0.86rem; display: flex; flex-direction: column; gap: 0.35rem; flex: 1;">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.4rem;">
            <a href={`/citations/${c.slug}/`} style="font-family: var(--font-mono); font-size: 0.76rem; font-weight: 700;">{c.id}</a>
            <span class={`badge badge-ver-${c.verification_level}`}>{VERIFICATION_LABELS[c.verification_level]}</span>
          </div>
          <div style="font-weight: 700;">{c.date_display} — {c.source_publication.split('(')[0].trim()}</div>
          <div style="color: var(--ink-muted); font-size: 0.82rem;">{c.short_gloss}</div>
          <blockquote style="margin: 0.3rem 0 0; padding-left: 0.65rem; border-left: 2px solid var(--border); font-size: 0.79rem; color: var(--ink-muted);">
            {c.verbatim_quote.slice(0, 160)}{c.verbatim_quote.length > 160 ? '…' : ''}
          </blockquote>
          <div style="margin-top: auto; padding-top: 0.45rem; font-size: 0.79rem;">
            <a href={`/citations/${c.slug}/`}>Citation record</a> ·{' '}
            <a href={c.scan.hosted_path!} target="_blank" rel="noopener noreferrer">Full scan ↗</a> ·{' '}
            <a href={c.source_url} target="_blank" rel="noopener noreferrer">Host archive ↗</a>
          </div>
        </figcaption>
      </figure>
    ))}
  </div>

  {additionalScans.length > 0 && (
    <details style="margin-top: 1.15rem; border: 1px solid var(--border); border-radius: 8px; padding: 0.85rem 1.05rem; background: var(--surface);">
      <summary style="cursor: pointer; font-weight: 600; font-size: 0.94rem;">
        Browse all {additionalScans.length} additional rights-cleared primary-source scans in this investigation
      </summary>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 0.9rem; margin-top: 1rem;">
        {additionalScans.map((c) => (
          <div style="border: 1px solid var(--border); border-radius: 6px; padding: 0.7rem; background: var(--bg); font-size: 0.83rem;">
            <a href={c.scan.hosted_path!} target="_blank" rel="noopener noreferrer">
              <img
                src={c.scan.hosted_path!}
                alt={`Scan ${c.id}`}
                style="width: 100%; height: 140px; object-fit: cover; object-position: top; border-radius: 4px; margin-bottom: 0.45rem;"
                loading="lazy"
              />
            </a>
            <div style="font-family: var(--font-mono); font-size: 0.73rem; color: var(--accent);">
              <a href={`/citations/${c.slug}/`}>{c.id}</a> · {c.date_display}
            </div>
            <div style="font-weight: 600; margin: 0.15rem 0;">{c.attested_form} — {c.short_gloss}</div>
            <div style="font-size: 0.77rem;">
              <a href={`/citations/${c.slug}/`}>Record</a> ·{' '}
              <a href={c.scan.hosted_path!} target="_blank" rel="noopener noreferrer">Scan ↗</a> ·{' '}
              <a href={c.source_url} target="_blank" rel="noopener noreferrer">Archive ↗</a>
            </div>
          </div>
        ))}
      </div>
    </details>
  )}

  {externalPost1930.length > 0 && (
    <div class="pub-notice" style="margin-top: 1rem;">
      <strong>Post-1930 Attestations (External Archive Links Only):</strong> To respect the U.S. pre-1931 public-domain boundary,
      scans published in 1931 or later are linked directly at their institutional viewers rather than redistributed in this repository:{' '}
      {externalPost1930.map((c, idx) => (
        <>
          {idx > 0 && ' · '}
          <a href={`/citations/${c.slug}/`}>{c.id} ({c.date_display})</a> [
          <a href={c.source_url} target="_blank" rel="noopener noreferrer">viewer ↗</a>]
        </>
      ))}
    </div>
  )}
</section>
