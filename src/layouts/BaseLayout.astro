---
import ScholarHead from '../components/ScholarHead.astro';
import { SITE_ACRONYM, SITE_EXPANDED, SITE_LICENSE, SITE_LICENSE_URL, SITE_GITHUB_URL } from '../consts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  isArticle?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  authorCitation?: string;
  authorOrcid?: string;
  coAuthors?: { name: string; citationName: string; orcid?: string }[];
  keywords?: string[];
  zenodoDoi?: string;
  pdfUrl?: string;
  ogImage?: string;
}

const props = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <ScholarHead {...props} canonicalUrl={canonicalUrl} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-link">
          <span class="brand-acronym"><span>DR</span>Ag<span>NE</span>t</span>
          <span class="brand-expanded">{SITE_EXPANDED}</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href="/">Case Files</a>
          <a href="/submit/">Submit a Scan</a>
          <a href="/about/">Methodology</a>
          <a href={SITE_GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <strong>{SITE_ACRONYM}</strong> ({SITE_EXPANDED}) — Open-access historical lexicography,
        physical-ink proof plates, and machine-validated JSON ledgers. Licensed under{' '}
        <a href={SITE_LICENSE_URL} target="_blank" rel="noopener noreferrer">{SITE_LICENSE}</a> for
        unrestricted scholarly reuse, dictionary ingestion, and archival preservation.
      </div>
    </footer>
  </body>
</html>
