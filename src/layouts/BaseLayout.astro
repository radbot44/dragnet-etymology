---
import ScholarHead from '../components/ScholarHead.astro';
import { SITE_ACRONYM, SITE_EXPANDED, SITE_LICENSE, SITE_LICENSE_URL, SITE_GITHUB_URL } from '../consts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  isArticle?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  authorCitation?: string;
  authorOrcid?: string;
  coAuthors?: { name: string; citationName: string; orcid?: string }[];
  keywords?: string[];
  journalDoi?: string;
  pdfUrl?: string;
  ogImage?: string;
}

const props = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <ScholarHead {...props} canonicalUrl={canonicalUrl} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-link">
          <span class="brand-acronym"><span>DR</span>Ag<span>NE</span>t</span>
          <span class="brand-expanded">{SITE_EXPANDED}</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href="/">Case Files</a>
          <a href="/citations/">Citation Index</a>
          <a href="/open-questions/">Open Questions</a>
          <a href="/protocols/">Evidence &amp; Methods</a>
          <a href="/submit/">Submit</a>
          <a href={SITE_GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container" style="display: flex; flex-direction: column; gap: 0.45rem;">
        <div>
          <strong>{SITE_ACRONYM}</strong> ({SITE_EXPANDED}) — Investigating the unknown origins of English words through
          AI-assisted archival research, primary-source scans, and open historical lexicography.
        </div>
        <div style="font-size: 0.82rem; color: var(--ink-muted);">
          Original research prose and citation metadata licensed under{' '}
          <a href={SITE_LICENSE_URL} target="_blank" rel="noopener noreferrer">{SITE_LICENSE}</a>; site code under MIT.
          Hosted archival page images are pre-1931 U.S. public-domain works; post-1930 sources are linked externally (
          <a href="/protocols/#rights">Image Rights &amp; Publication Policy</a> ·{' '}
          <a href="/protocols/#corrections">Corrections Log</a> · <a href="/rss.xml">Full-Text RSS</a>).
        </div>
      </div>
    </footer>
  </body>
</html>
