---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProofPlateGallery from '../../components/ProofPlateGallery.astro';
import ReuseCitationDrawer from '../../components/ReuseCitationDrawer.astro';
import { SITE_ACRONYM, SITE_EXPANDED } from '../../consts';
import {
  getLedgerBySlug,
  computeLedgerStats,
  VERIFICATION_LABELS,
} from '../../lib/ledgers';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const articleHeadings = headings.filter(({ depth }) => depth <= 3);
const d = entry.data;
const ledger = getLedgerBySlug(d.ledgerSlug);
const stats = computeLedgerStats(ledger.citations);
const byId = new Map(ledger.citations.map((c) => [c.id, c]));

const featuredScans = d.featuredScanIds
  .map((id) => byId.get(id))
  .filter((c): c is NonNullable<typeof c> => Boolean(c && c.scan.hosted_path));
const featuredSet = new Set(featuredScans.map((c) => c.id));
const additionalScans = ledger.citations.filter(
  (c) => Boolean(c.scan.hosted_path) && !featuredSet.has(c.id)
);
const externalAttestations = ledger.citations.filter(
  (c) => c.record_type === 'attestation' && !c.scan.hosted_path
);
const rejectedLeads = d.rejectedLeadIds
  .map((id) => byId.get(id))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const canonicalUrl = new URL(`/cases/${entry.id}/`, Astro.site).toString();
const pubYear = d.pubDate.getUTCFullYear();
const leadSurname = (d.authorCitation.split(',')[0] || 'author').trim().toLowerCase().replace(/[^a-z0-9]/g, '');
const allAuthorsBib = [d.authorCitation, ...(d.coAuthors || []).map((c) => c.citationName)].join(' and ');

const bibtex = `@techreport{${leadSurname}_${pubYear}_${entry.id.replace(/[^a-z0-9]/gi, '_')},
  author      = {${allAuthorsBib}},
  title       = {{${d.title}}},
  institution = {${SITE_ACRONYM} --- ${SITE_EXPANDED}},
  year        = {${pubYear}},
  month       = {${d.pubDate.getUTCMonth() + 1}},
  number      = {${d.caseNumber} (${d.targetId})},
  url         = {${canonicalUrl}}${d.journalDoi ? `,\n  doi         = {${d.journalDoi}}` : ''}
}`;

const statusLabels: Record<string, string> = {
  working_paper: 'Working Paper',
  manuscript_in_preparation: 'Working Paper (Journal Manuscript in Preparation)',
  under_review: 'Submitted Manuscript Under Review',
  published_article: 'Published Research',
  dictionary_submitted: 'Submitted to Historical Dictionaries',
};
---

<BaseLayout
  title={`${d.title} | ${SITE_ACRONYM}`}
  description={d.subtitle}
  isArticle={true}
  pubDate={d.pubDate}
  updatedDate={d.updatedDate}
  author={d.author}
  authorCitation={d.authorCitation}
  authorOrcid={d.authorOrcid}
  coAuthors={d.coAuthors}
  keywords={d.keywords}
  journalDoi={d.journalDoi}
  pdfUrl={d.pdfUrl}
  ogImage={featuredScans[0]?.scan.hosted_path || undefined}
>
  <article style="padding: 2rem 0 3rem;">
    <div class="overview-layout case-overview">
    <header class="page-intro">
      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-bottom: 0.45rem;">
        <span style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;">
          {d.caseNumber} · {d.targetId} · Headword: {d.headword}
        </span>
        <span class="badge">{statusLabels[d.publicationStatus] || d.publicationStatus}</span>
      </div>
      <h1 class="citation_title" style="font-family: var(--font-serif); font-size: clamp(1.9rem, 3.5vw, 2.6rem); line-height: 1.16; margin: 0.25rem 0 0.6rem;">
        {d.title}
      </h1>
      <p style="font-size: 1.08rem; color: var(--ink-muted); margin: 0 0 0.85rem;">
        {d.subtitle}
      </p>
      <div style="font-size: 0.86rem; color: var(--ink-muted); display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 0.6rem 0;">
        <span class="citation_author">
          By <strong>{d.author}</strong>
          {d.coAuthors && d.coAuthors.length > 0 && (
            <span> &amp; {d.coAuthors.map((c) => c.name).join(', ')}</span>
          )}
        </span>
        <span>·</span>
        <time datetime={d.pubDate.toISOString()}>Published {d.pubDate.toISOString().slice(0, 10)}</time>
        <span>·</span>
        <a href={`/citations/?headword=${encodeURIComponent(ledger.headword)}`}>
          Browse all {stats.totalEvaluated} evaluated citations →
        </a>
        <span>·</span>
        <a href={`/ledgers/${d.ledgerSlug}.json`} target="_blank" rel="noopener noreferrer">JSON Ledger</a>
        <span>·</span>
        <a href={`/cases/${entry.id}.bib`} download={`${entry.id}.bib`}>Cite (.bib)</a>
      </div>

      <nav class="jump-links" aria-label="On this page">
        <a href="#evidence-summary">Evidence summary</a>
        <a href="#timeline">Timeline</a>
        <a href="#primary-scans">Scans</a>
        <a href="#research">Full case study</a>
        <a href="#reuse-kit-heading">Cite or reuse</a>
      </nav>
      <div class="pub-notice">
        <strong>Publication &amp; Verification Status:</strong> {d.publicationStatusNote} Currently{' '}
        <strong>{stats.agentVerified}</strong> records are <code>agent-verified</code>,{' '}
        <strong>{stats.humanVerified}</strong> are independently <code>human-verified</code>, and{' '}
        <strong>{stats.externallyRecognized}</strong> are baseline quotations already recognized in reference dictionaries.
      </div>
    </header>

    <div class="stat-strip overview-stats">
      <div class="stat-card">
        <div class="stat-label">{d.earliestKnownAttestation.label ?? 'Earliest Known Attestation'}</div>
        <div class="stat-value">{d.earliestKnownAttestation.dateDisplay}</div>
        <div class="stat-sub">
          <a href={d.earliestKnownAttestation.url} target="_blank" rel="noopener noreferrer">
            {d.earliestKnownAttestation.source}
          </a>{' '}
          ({d.earliestKnownAttestation.citedIn})
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-label">{d.earliestNewDiscovery.label ?? 'Earliest Newly Uncovered Evidence'}</div>
        <div class="stat-value">{d.earliestNewDiscovery.dateDisplay}</div>
        <div class="stat-sub">
          <a href={`/citations/${d.earliestNewDiscovery.certId.toLowerCase()}/`}>{d.earliestNewDiscovery.source}</a>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-label">{d.earliestNewDiscovery.summaryLabel ?? 'Antedating / Chronological Advance'}</div>
        <div class="stat-value" style="font-size: 1.15rem;">{d.earliestNewDiscovery.antedatingSummary}</div>
        <div class="stat-sub">{d.earliestNewDiscovery.summaryNote ?? d.earliestNewDiscovery.location}</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Evaluated Citations (Live from Ledger)</div>
        <div class="stat-value">{stats.totalEvaluated}</div>
        <div class="stat-sub">
          {stats.attestations} attestations · {stats.hypotheses} hypotheses · {stats.rejectedLeads} rejected leads
        </div>
      </div>
    </div>

    </div>

    <section id="evidence-summary" class="split-section">
      <section style="border: 1px solid var(--border); border-radius: 8px; padding: 1.15rem 1.25rem; background: var(--surface); margin: 1.5rem 0;">
        <div style="font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--ink-muted); margin-bottom: 0.35rem;">
          Prior Scholarship
        </div>
        <p style="margin: 0; font-size: 0.94rem;">{d.priorArtSummary}</p>
      </section>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr)); gap: 1.15rem; margin: 1.5rem 0;">
        <section style="border: 1px solid #b7e2c7; border-radius: 8px; padding: 1.15rem; background: #f6fbf8;">
          <div style="font-family: var(--font-mono); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; color: #165b33; margin-bottom: 0.45rem;">
            Established by Primary-Source Scans
          </div>
          <ul style="margin: 0; padding-left: 1.15rem; font-size: 0.91rem; display: flex; flex-direction: column; gap: 0.45rem;">
            {d.establishedFacts.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </section>

        <section style="border: 1px solid #f1d49b; border-radius: 8px; padding: 1.15rem; background: #fffdf7;">
          <div style="font-family: var(--font-mono); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; color: #7c4a03; margin-bottom: 0.45rem;">
            Proposed Origin Hypothesis ({d.originHypothesis.label})
          </div>
          <p style="font-size: 0.91rem; margin: 0 0 0.65rem;">{d.originHypothesis.summary}</p>
          <p style="font-size: 0.83rem; color: var(--ink-muted); margin: 0; border-top: 1px solid #f1d49b; padding-top: 0.5rem;">
            <strong>Evidence boundary:</strong> {d.originHypothesis.boundaryNote}
          </p>
        </section>
      </div>

      <h2 id="timeline">Chronological Attestation Timeline</h2>
      <ol class="timeline-list">
        {d.chronologyTimeline.map((item) => (
          <li class="timeline-item">
            <div style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent); font-weight: 700;">
              {item.date} · <a href={`/citations/${item.certId.toLowerCase()}/`}>{item.certId}</a>
            </div>
            <div style="font-weight: 700; margin: 0.1rem 0;">
              “{item.form}” — <span style="font-weight: 400; color: var(--ink-muted);">{item.source}</span>
            </div>
            <div style="font-size: 0.9rem;">{item.note}</div>
          </li>
        ))}
      </ol>
    </section>

    <ProofPlateGallery
      featuredScans={featuredScans}
      additionalScans={additionalScans}
      externalAttestations={externalAttestations}
    />

    <section id="research" class="reading-spread" aria-label="Full case study">
      {articleHeadings.length > 0 && (
        <nav class="reading-rail" aria-label="Case study sections">
          <h2>In this case file</h2>
          <ul>
            <li><a href="#evidence-summary">Evidence summary</a></li>
            <li><a href="#timeline">Timeline</a></li>
            <li><a href="#primary-scans">Primary-source scans</a></li>
            {articleHeadings.map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}
            <li><a href="#rejected-leads">Rejected leads</a></li>
            {d.openQuestions.length > 0 && <li><a href="#case-open-questions">Open questions</a></li>}
            <li><a href="#reuse-kit-heading">Cite or reuse</a></li>
          </ul>
        </nav>
      )}
      <div class="reading-column monograph"><Content /></div>
    </section>

    <section class="split-section" id="rejected-leads">

      <h2>Rejected Leads (OCR Errors, Misdated Volumes &amp; Uncorroborated Claims)</h2>
      <p style="font-size: 0.92rem; color: var(--ink-muted);">
        Note: Scholarly etymological proposals that are merely weakened by chronological or phonological evidence are classified
        separately as <a href={`/citations/?headword=${encodeURIComponent(ledger.headword)}&type=hypothesis`}>evaluated hypotheses</a>{' '}
        rather than listed here as rejected leads.
      </p>
      <div class="citation-table-wrap" role="region" aria-label="Case file citation records" tabindex="0" style="margin-bottom: 2rem;">
        <table class="citation-table responsive-evidence-table rejected-table" role="table">
          <thead role="rowgroup">
            <tr role="row">
              <th role="columnheader" scope="col">Record</th>
              <th role="columnheader" scope="col">Apparent Lead</th>
              <th role="columnheader" scope="col">Category</th>
              <th role="columnheader" scope="col">What the Original Source Shows</th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            {rejectedLeads.map((r) => (
              <tr role="row">
                <td role="cell" style="font-family: var(--font-mono); font-size: 0.8rem; white-space: nowrap;"><span class="mobile-label" aria-hidden="true">Record</span>
                  <a href={`/citations/${r.slug}/`}>{r.id}</a>
                </td>
                <td role="cell"><span class="mobile-label" aria-hidden="true">Apparent lead</span>
                  <strong>{r.attested_form}</strong> ({r.date_display})
                  <div style="font-size: 0.78rem; color: var(--ink-muted);">{r.source_publication.split('(')[0].trim()}</div>
                </td>
                <td role="cell"><span class="mobile-label" aria-hidden="true">Category</span>
                  <span class="badge badge-type-rejected_lead">{(r.record_subtype || 'rejected_lead').replace(/_/g, ' ')}</span>
                </td>
                <td role="cell" style="font-size: 0.86rem;"><span class="mobile-label" aria-hidden="true">What the original source shows</span>
                  {r.analysis_notes.slice(0, 220)}{r.analysis_notes.length > 220 ? '…' : ''}{' '}
                  <a href={`/citations/${r.slug}/`}>Full note →</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {d.openQuestions.length > 0 && (
        <>
          <h2 id="case-open-questions">Open Questions for Further Archival Work</h2>
          <ul>
            {d.openQuestions.map((q) => (
              <li>{q}</li>
            ))}
          </ul>
        </>
      )}

      <ReuseCitationDrawer
        slug={entry.id}
        title={d.title}
        author={d.author}
        pubYear={pubYear}
        canonicalUrl={canonicalUrl}
        ledgerPath={`/ledgers/${d.ledgerSlug}.json`}
        journalDoi={d.journalDoi}
        reuseKit={d.reuseKit}
        {...d.reuseKit}
        bibtex={bibtex}
      />
    </section>
  </article>
</BaseLayout>
