---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_ACRONYM, SITE_EXPANDED, SITE_HEADLINE, SITE_TAGLINE } from '../consts';
import { getAllCitations, getLedgerBySlug, computeLedgerStats, getOpenQuestionsData, VERIFICATION_LABELS } from '../lib/ledgers';

const cases = (await getCollection('cases')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const allCitations = getAllCitations();
const globalStats = computeLedgerStats(allCitations);
const openData = getOpenQuestionsData();
const sampleCitations = allCitations.filter((c) => c.record_type === 'attestation').slice(0, 6);
---

<BaseLayout title={`${SITE_ACRONYM} — ${SITE_HEADLINE}`} description={SITE_TAGLINE}>
  <section class="overview-layout home-overview" style="padding: 2.75rem 0 2rem; border-bottom: 1px solid var(--border);">
    <div class="page-intro">
    <div style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;">
      Open-Access Historical Lexicography
    </div>
    <h1 style="font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 2.9rem); line-height: 1.14; margin: 0.4rem 0 0.65rem; max-width: 24ch;">
      {SITE_HEADLINE}
    </h1>
    <p style="font-size: 1.08rem; color: var(--ink-muted); max-width: 62ch; margin: 0 0 1.4rem;">
      {SITE_TAGLINE} Follow the evidence from a word’s case file to its transcription, verification status, or archival scan.
    </p>

    <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.75rem;">
      <a href="/citations/" style="background: var(--ink); color: var(--bg); padding: 0.6rem 1.05rem; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 0.92rem;">
        Search Citation Index ({globalStats.totalEvaluated} records) →
      </a>
      <a href="/open-questions/" style="border: 1px solid var(--border); background: var(--surface); color: var(--ink); padding: 0.6rem 1.05rem; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 0.92rem;">
        Browse Open Questions ({openData.total_targets} words)
      </a>
      <a href="/protocols/" style="border: 1px solid var(--border); background: var(--surface); color: var(--ink); padding: 0.6rem 1.05rem; border-radius: 6px; text-decoration: none; font-size: 0.92rem;">
        Verification Standards &amp; Protocols
      </a>
    </div>

    </div>
    <div class="stat-strip overview-stats">
      <div class="stat-card">
        <div class="stat-label">Evaluated Citations</div>
        <div class="stat-value">{globalStats.totalEvaluated}</div>
        <div class="stat-sub">{globalStats.attestations} attestations · {globalStats.hypotheses} hypotheses</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Primary-Source Scans</div>
        <div class="stat-value">{globalStats.hostedScans}</div>
        <div class="stat-sub">Pre-1931 public-domain scans hosted in repo</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Rejected Leads Logged</div>
        <div class="stat-value">{globalStats.rejectedLeads}</div>
        <div class="stat-sub">OCR errors, misdated volumes &amp; unattested claims</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Verification Transparency</div>
        <div class="stat-value">{globalStats.agentVerified} Agent / {globalStats.humanVerified} Human</div>
        <div class="stat-sub">{globalStats.externallyRecognized} baseline quotes in OED / Green's</div>
      </div>
    </div>
  </section>

  <section style="padding: 2.2rem 0 1rem;">
    <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;">
      <h2 style="font-family: var(--font-serif); font-size: 1.6rem; margin: 0;">Published Case Files</h2>
      <span style="font-size: 0.88rem; color: var(--ink-muted);">Counts generated at build time from JSON ledgers</span>
    </div>

    <div class="filter-bar case-filter" role="search" aria-label="Find a case file" hidden>
      <input class="filter-input" id="case-search" type="search" aria-label="Search case files" placeholder="Find a word or case title" />
      <p id="case-count" role="status" class="evidence-notice"></p>
    </div>
    <p class="citation-empty" id="case-empty" hidden>No case files match. Try a shorter word or <a href="/citations/">search the Citation Index</a>.</p>
    <div class="case-grid case-directory">
      {cases.map((entry) => {
        const d = entry.data;
        const ledger = getLedgerBySlug(d.ledgerSlug);
        const st = computeLedgerStats(ledger.citations);
        return (
          <article class="case-card" data-case-search={`${d.headword} ${d.relatedForms.join(" ")} ${d.title}`.toLowerCase()}>
            <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; font-family: var(--font-mono); font-size: 0.78rem; color: var(--accent); font-weight: 700; text-transform: uppercase;">
              <span>{d.caseNumber}</span>
            </div>
            <h3 class="case-card-title">
              <a href={`/cases/${entry.id}/`}>{d.headword}</a>
            </h3>
            <p style="color: var(--ink-muted); margin: 0 0 0.9rem; font-size: 0.96rem;">{d.title}</p>
            <p class="case-result">{d.earliestNewDiscovery.antedatingSummary}</p>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; font-size: 0.83rem; color: var(--ink-muted);">
              <span class="badge badge-type-attestation">{st.attestations} attestations</span>
              <span class="badge">{st.hostedScans} hosted scans</span>
              <span class="badge badge-type-hypothesis">{st.hypotheses} evaluated hypotheses</span>
              <span class="badge badge-type-rejected_lead">{st.rejectedLeads} rejected leads</span>
              <span style="margin-left: auto;">
                <a href={`/cases/${entry.id}/`}><strong>Read case file →</strong></a>
              </span>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section style="padding: 1.8rem 0 2.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.85rem;">
      <h2 style="font-family: var(--font-serif); font-size: 1.5rem; margin: 0;">Sample Records from the Citation Index</h2>
      <a href="/citations/" style="font-size: 0.9rem;">Search &amp; filter all {globalStats.totalEvaluated} records →</a>
    </div>
    <div class="citation-table-wrap" role="region" aria-label="Sample citation records" tabindex="0">
      <table class="citation-table responsive-evidence-table homepage-table" role="table">
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" scope="col">Date</th>
            <th role="columnheader" scope="col">Form</th>
            <th role="columnheader" scope="col">Source</th>
            <th role="columnheader" scope="col">Sense / Classification</th>
            <th role="columnheader" scope="col">Verification</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {sampleCitations.map((c) => (
            <tr role="row">
              <td role="cell" style="font-family: var(--font-mono); font-size: 0.82rem;"><span class="mobile-label" aria-hidden="true">Date</span>{c.date_display}</td>
              <td role="cell"><span class="mobile-label" aria-hidden="true">Form</span>
                <a href={`/citations/${c.slug}/`}><strong>{c.attested_form}</strong></a>
              </td>
              <td role="cell"><span class="mobile-label" aria-hidden="true">Source</span>{c.source_publication.split('(')[0].trim()}</td>
              <td role="cell"><span class="mobile-label" aria-hidden="true">Sense / classification</span>{c.short_gloss}</td>
              <td role="cell"><span class="mobile-label" aria-hidden="true">Verification</span>
                <span class={`badge badge-ver-${c.verification_level}`}>
                  {VERIFICATION_LABELS[c.verification_level]}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
  <script>
    const bar = document.querySelector<HTMLElement>('.case-filter');
    const input = document.querySelector<HTMLInputElement>('#case-search');
    const counter = document.querySelector('#case-count');
    const empty = document.querySelector<HTMLElement>('#case-empty');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-case-search]'));
    if (bar && input && counter && empty) {
      const filter = () => {
        const tokens = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
        cards.forEach(card => { card.hidden = !tokens.every(token => card.dataset.caseSearch?.includes(token)); });
        const visible = cards.filter(card => !card.hidden).length;
        counter.textContent = `${visible} of ${cards.length} case files`;
        empty.hidden = visible > 0;
      };
      bar.hidden = false;
      input.addEventListener('input', filter);
      filter();
    }
  </script>
</BaseLayout>
