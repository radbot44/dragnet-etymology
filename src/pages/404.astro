---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_ACRONYM } from '../consts';
---

<BaseLayout title={`404 — Case File Not Found | ${SITE_ACRONYM}`} description="Page not found.">
  <section class="prose-container" style="padding: 4rem 0; text-align: center;">
    <div style="font-family: var(--font-mono); color: var(--accent); font-weight: 700;">ERROR 404</div>
    <h1 style="font-family: var(--font-serif); font-size: 2.2rem; margin: 0.4rem 0;">
      No Ink Found at This Shelfmark
    </h1>
    <p style="color: var(--ink-muted);">
      The requested dossier or proof plate does not exist at this URL.
    </p>
    <p><a href="/" style="font-weight: 700;">← Return to All DRAgNEt Case Files</a></p>
  </section>
</BaseLayout>
