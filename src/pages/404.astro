---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_ACRONYM } from '../consts';
---

<BaseLayout title={`404 — Page Not Found | ${SITE_ACRONYM}`} description="Page not found.">
  <section class="split-section" style="padding: 4rem 0; text-align: center;">
    <div style="font-family: var(--font-mono); color: var(--accent); font-weight: 700;">ERROR 404</div>
    <h1 style="font-family: var(--font-serif); font-size: 2.2rem; margin: 0.4rem 0;">
      Page not found
    </h1>
    <p style="color: var(--ink-muted);">
      This link may be outdated. Try searching the Citation Index or browsing the case files.
    </p>
    <div class="jump-links centered"><a href="/citations/">Search citations</a><a href="/">Browse case files</a></div>
  </section>
</BaseLayout>
