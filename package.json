{
  "name": "dragnet-etymology",
  "version": "4.0.0",
  "private": true,
  "description": "DRAgNEt — Deep Research Agent Network for Etymology: Open-access archival case files, primary-scan proof plates, claim-level evidence graphs, and machine-validated lexicons deployed on Cloudflare Static Assets.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "add-case": "python3 scripts/add_case.py",
    "ingest": "python3 scripts/ingest_monograph_ledger.py",
    "review-claim": "python3 scripts/record_claim_review.py",
    "validate": "node scripts/validate-site.mjs",
    "validate:claims": "node scripts/validate-claims.mjs --require-all-cases",
    "validate:py": "python3 scripts/validate_submission.py",
    "package-release": "python3 scripts/package_release_assets.py"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.9",
    "astro": "^5.7.14",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.168.0"
  }
}
