{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dragnet-etymology",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/.well-known/*",
      "/oauth/*",
      "/mcp",
      "/mcp/*",
      "/api/*",
      "/scans/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dragnet-db",
      "database_id": "75ef2563-a46c-459f-943f-09adf7b496d5"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SCANS",
      "bucket_name": "dragnet-scans"
    }
  ],
  "vars": {
    "GITHUB_REPO": "radbot44/dragnet-etymology",
    "GITHUB_BASE_BRANCH": "main",
    "SITE_ORIGIN": "https://dragnet.tch.one"
  }
}
